{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kit",
    "title",
    "subtitle",
    "road",
    "buildings"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        4
      ]
    },
    "kit": {
      "type": "string",
      "enum": [
        "ff9-crafted-corner-v3"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "bend",
        "sway"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 5.2,
          "maximum": 7.2
        },
        "bend": {
          "type": "number",
          "minimum": -2.5,
          "maximum": 2.5
        },
        "sway": {
          "type": "number",
          "minimum": -0.8,
          "maximum": 0.8
        }
      }
    },
    "buildings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "side",
          "z",
          "width",
          "depth",
          "setback",
          "assembly"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "bakery",
              "florist",
              "inn",
              "toys",
              "cafe",
              "books",
              "home",
              "apothecary"
            ]
          },
          "name": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "z": {
            "type": "number",
            "minimum": -8.5,
            "maximum": 23.5
          },
          "width": {
            "type": "number",
            "minimum": 4.6,
            "maximum": 6.5
          },
          "depth": {
            "type": "number",
            "minimum": 3.8,
            "maximum": 5.3
          },
          "setback": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.15
          },
          "assembly": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stories",
              "roof",
              "roofRise",
              "bay",
              "awning",
              "balcony",
              "chimney"
            ],
            "properties": {
              "stories": {
                "type": "integer",
                "enum": [
                  2,
                  3
                ]
              },
              "roof": {
                "type": "string",
                "enum": [
                  "clay",
                  "teal"
                ]
              },
              "roofRise": {
                "type": "number",
                "minimum": 2.8,
                "maximum": 4.2
              },
              "bay": {
                "type": "string",
                "enum": [
                  "none",
                  "octagonal"
                ]
              },
              "awning": {
                "type": "string",
                "enum": [
                  "none",
                  "striped"
                ]
              },
              "balcony": {
                "type": "string",
                "enum": [
                  "none",
                  "timber"
                ]
              },
              "chimney": {
                "type": "string",
                "enum": [
                  "none",
                  "tall-stone"
                ]
              }
            }
          }
        }
      }
    }
  }
}